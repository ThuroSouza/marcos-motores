    "auth:smoke": "tsx scripts/auth-smoke.ts",
    "categories:smoke": "tsx scripts/categories-smoke.ts",
    "motorcycles:smoke": "tsx scripts/motorcycles-smoke.ts",
    "images:smoke": "tsx scripts/images-smoke.ts",
    "catalog:smoke": "tsx scripts/catalog-smoke.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "isbot": "^5.1.36",
    "lucide-react": "^1.61.0",
